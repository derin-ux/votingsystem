<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.onlinevoting.controller.VoterLoginController"
           stylesheets="@../css/voter.css"
           styleClass="root-pane"
           prefWidth="800" prefHeight="560">

    <VBox styleClass="card" alignment="CENTER" spacing="14"
          maxWidth="380" maxHeight="-Infinity">

        <Label text="Voter login" styleClass="title"/>
        <Label text="Sign in with your NIN to cast your vote." styleClass="subtitle"/>

        <VBox spacing="4">
            <Label text="NIN" styleClass="field-label"/>
            <TextField fx:id="ninField" promptText="11-digit NIN"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="Your password"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label"
               visible="false" wrapText="true" minHeight="18"/>

        <Button text="Log in" onAction="#handleLogin"
                defaultButton="true" maxWidth="Infinity" styleClass="primary-button"/>

        <HBox alignment="CENTER" spacing="4">
            <Label text="New voter?" styleClass="subtitle"/>
            <Hyperlink text="Register" onAction="#handleGoToRegister"/>
        </HBox>
    </VBox>
</StackPane>