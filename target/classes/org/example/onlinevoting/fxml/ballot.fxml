<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.onlinevoting.controller.BallotController"
            stylesheets="@../css/voter.css , @../css/ballot.css"
            styleClass="root-pane"
            prefWidth="900" prefHeight="680">

    <top>
        <HBox styleClass="ballot-bar" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label fx:id="electionTitleLabel" styleClass="ballot-title"/>
                <Label fx:id="voterNameLabel" styleClass="subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Log out" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="ballot-scroll" hbarPolicy="NEVER">
            <VBox fx:id="positionsBox" spacing="22" styleClass="ballot-content"/>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="ballot-bar" alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="progressLabel" styleClass="subtitle"/>
                <Label fx:id="errorLabel" styleClass="error-label"
                       visible="false" wrapText="true" minHeight="18"/>
            </VBox>
            <Button fx:id="submitButton" text="Submit vote" onAction="#handleSubmit"
                    styleClass="primary-button" prefWidth="160"/>
        </HBox>
    </bottom>
</BorderPane>