<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.onlinevoting.controller.VoterRegistrationController"
           stylesheets="@../css/voter.css"
           styleClass="root-pane"
           prefWidth="800" prefHeight="640">

    <VBox styleClass="card" alignment="CENTER" spacing="14"
          maxWidth="420" maxHeight="-Infinity">

        <Label text="Create your voter account" styleClass="title"/>
        <Label text="Register once with your NIN to take part in elections."
               styleClass="subtitle" wrapText="true" textAlignment="CENTER"/>

        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="First name" styleClass="field-label"/>
                <TextField fx:id="firstNameField" promptText="First name"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Last name" styleClass="field-label"/>
                <TextField fx:id="lastNameField" promptText="Last name"/>
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label text="NIN" styleClass="field-label"/>
            <TextField fx:id="ninField" promptText="11-digit NIN"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="At least 6 characters"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Confirm password" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Repeat your password"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label"
               visible="false" wrapText="true" minHeight="18"/>

        <Button text="Register" onAction="#handleRegister"
                defaultButton="true" maxWidth="Infinity" styleClass="primary-button"/>

        <HBox alignment="CENTER" spacing="4">
            <Label text="Already registered?" styleClass="subtitle"/>
            <Hyperlink text="Back to login" onAction="#handleBackToLogin"/>
        </HBox>
    </VBox>
</StackPane>